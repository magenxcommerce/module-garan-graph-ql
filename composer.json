{
    "name": "magenx/module-garan-graph-ql",
    "description": "EU harmonised legal guarantee notice and EU GARAN durability label (Implementing Regulation (EU) 2025/1960) over GraphQL for headless storefronts. Fork of copex/module-warranty-label.",
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "ext-gd": "*",
        "magento/framework": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-graph-ql": "*",
        "magento/module-config": "*",
        "magento/module-configurable-product": "*",
        "magento/module-eav": "*",
        "magento/module-graph-ql": "*",
        "magento/module-quote": "*",
        "magento/module-quote-graph-ql": "*",
        "magento/module-sales": "*",
        "magento/module-sales-graph-ql": "*",
        "magento/module-store": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magenx\\GaranGraphQl\\": ""
        }
    },
    "archive": {
        "exclude": [
            ".gitignore",
            "phpunit.xml",
            "Test/*"
        ]
    }
}
