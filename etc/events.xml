<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        Dispatched by Magento\Sales\Model\Order\Email\Sender\OrderSender only, so this is the order confirmation and
        never an invoice, shipment, credit memo or comment email.
    -->
    <event name="email_order_set_template_vars_before">
        <observer name="magenx_garan_register_email_attachments"
                  instance="Magenx\GaranGraphQl\Observer\RegisterEmailAttachments"/>
    </event>
</config>
